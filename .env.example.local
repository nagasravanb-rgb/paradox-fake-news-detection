# API
PARADOX_LOG_LEVEL=info

# Auth — set AUTH_REQUIRED=true in any shared environment
AUTH_REQUIRED=false
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Verification policy
MAX_VERIFICATION_ROUNDS=2
SELF_VERIFY_THRESHOLD=0.70
MAX_EVIDENCE_ITEMS=10
REQUEST_TIMEOUT_MS=30000

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_CLASSIFY=gpt-4o-mini
LLM_MODEL_EXTRACT=gpt-4o-mini
LLM_MODEL_REASON=gpt-4o-mini
LLM_MODEL_SYNTHESIZE=gpt-4o-mini
LLM_MODEL_FORECAST=gpt-4o-mini
LLM_MODEL_DECISION=gpt-4o-mini

# Optional web search
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com

# Rate limit
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
